<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <groupId>io.github.setchy</groupId>
    <artifactId>dgs-extended-formatters-sample</artifactId>
    <version>3.0.1-SNAPSHOT</version>

    <name>${project.artifactId}</name>
    <description>A sample graphql dgs service which utilizes dgs-extended-formatters</description>

    <properties>
        <dgs-extended-formatters.version>3.0.1-SNAPSHOT</dgs-extended-formatters.version>
        <dgs-platform-dependencies.version>12.0.1</dgs-platform-dependencies.version>

        <!-- Skip deploying this module when releasing -->
        <sonar.skip>true</sonar.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.netflix.graphql.dgs</groupId>
                <artifactId>graphql-dgs-platform-dependencies</artifactId>
                <!-- The DGS BOM/platform dependency. This is the only place you set version of DGS -->
                <version>${dgs-platform-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                TEMPORARY OVERRIDE - review/remove once Spring Boot bumps its own json-path pin to 3.x.
                Explicit override: Spring Boot 4.1.1's own BOM (inherited via spring-boot-starter-parent)
                pins json-path to 2.10.0, but DGS 12.0.1's runtime code (Jackson3DgsJsonMapper) requires
                the Jackson3JsonProvider class that only exists in json-path 3.0.0+. DGS's own BOM
                (graphql-dgs-platform) already correctly pins 3.0.0, but it arrives via a nested BOM
                import (graphql-dgs-platform-dependencies -> graphql-dgs-platform), which is "farther"
                than Spring Boot's single-hop parent-inherited pin, so Spring's incorrect 2.10.0 wins
                Maven's dependency-management precedence without this override.
                TODO: remove this override once spring-boot-starter-parent's json-path.version >= 3.0.0.
            -->
            <dependency>
                <groupId>com.jayway.jsonpath</groupId>
                <artifactId>json-path</artifactId>
                <version>3.0.0</version>
            </dependency>

            <!--
                TEMPORARY OVERRIDE - must be kept in sync with dgs-extended-formatters/pom.xml's
                protobuf-java.version; revisit whenever that property changes.
                Explicit override: Spring Boot 4.1.1's BOM pins protobuf-java to 4.35.1, but
                dgs-extended-formatters generates OpaqueResourceIDProto with protobuf-java gencode
                4.36.0 (see dgs-extended-formatters/pom.xml's protobuf-java.version). Loading that
                generated class with an older runtime throws
                ProtobufRuntimeVersionException ("Runtime version cannot be older than the linked
                gencode version"). Same root cause/shape as the json-path override above: Spring
                Boot's directly-inherited BOM pin wins over a version that needs to match our own
                generated code.
                TODO: bump this whenever dgs-extended-formatters/pom.xml's protobuf-java.version changes,
                and re-check whether it's still needed if Spring Boot's own pin ever catches up.
            -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.36.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.netflix.graphql.dgs</groupId>
            <artifactId>dgs-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.setchy</groupId>
            <artifactId>dgs-extended-formatters</artifactId>
            <version>${dgs-extended-formatters.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
