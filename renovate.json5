{
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "schedule:weekly"
  ],
  "labels": ["dependency"],
  "packageRules": [
     {
      "description": "Remove word `dependency` from commit messages and PR titles",
      "matchDatasources": ["npm"],
      "commitMessageTopic": "{{depName}}"
    }
  ],
  "customManagers": [
    {
      "description": "Keep README.md versions in-sync",
      "customType": "regex",
      "datasourceTemplate": "maven",
      "managerFilePatterns": ["(^|/).*\.md$"],
      "depNameTemplate": "io.github.setchy:dgs-extended-formatters",
      "matchStrings": [
        "\\s?<version>(?<currentValue>[\\w+\\.\\-]*)<\\/version>\\s?",
        "\\s?implementation \\'(?<depName>.*)\\:(?<currentValue>[\\w+\\.\\-]*)\\'\\s?"
      ],
    }
  ]
}
